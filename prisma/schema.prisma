// ============================================================
// ManuFlow ERP — Multi-tenant Manufacturing SaaS ERP
// MySQL / Prisma schema (String-based status constants)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------- Tenant / Org ----------------

model Company {
  id           String   @id @default(cuid())
  name         String
  gstin        String?
  pan          String?
  addressLine  String? @db.Text
  city         String?
  state        String?
  stateCode    String? // GST state code e.g. "27" MH, "24" GJ
  phone        String?
  email        String?
  logoText     String?
  bankAccountName   String? // bank details for invoice print
  bankAccountNumber String?
  bankIfsc          String?
  bankUpiId         String?
  bankName          String?
  bankBranch        String?
  pincode           String?
  invoiceTerms      String?  @db.Text // printed on tax invoices
  quotationTerms    String?  @db.Text // default terms on new quotations
  logoImage         String?  @db.MediumText // data: URL (PNG/JPG), printed on documents
  signatureImage    String?  @db.MediumText // data: URL, "Authorised signatory" on invoices
  roundOffTotals    Boolean  @default(true)  // round invoice / bill totals to the rupee
  docPrefixes       String?  @db.Text        // JSON { INV: "SI", PINV: "PB", ... } overrides of default prefixes
  // ---- Tally export: names must match the Tally company exactly (Tally never creates masters) ----
  tallyCompanyName     String? // SVCURRENTCOMPANY sent in the import envelope
  tallySalesLedger     String?
  tallyCgstLedger      String?
  tallySgstLedger      String?
  tallyIgstLedger      String?
  tallyFreightLedger   String?
  tallyRoundOffLedger  String?
  lockEnabled       Boolean  @default(false) // PIN needed to edit / cancel / delete saved documents
  lockPinHash       String?
  // Go-live (cutover) date: the first day the books are kept in ManuFlow. Imported opening figures are
  // dated just before it (src/lib/go-live.ts). Locked once opening stock has been imported against it.
  goLiveDate        DateTime?

  // ---- Subscription (managed from /platform-admin) ----
  isPlatform    Boolean   @default(false) // the platform operator's own company (not a customer org)
  slug          String?   @unique
  planId        String?
  status        String    @default("ACTIVE") // ACTIVE|SUSPENDED
  billingCycle  String    @default("MONTHLY") // MONTHLY|YEARLY
  paidUntil     DateTime?
  trialEndsAt   DateTime?
  // Per-org limit overrides ("Customize plan"); null = use the plan's limit
  maxUsers      Int?
  maxWarehouses Int?
  maxItems      Int?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plan         Plan?    @relation(fields: [planId], references: [id])
  items        Item[]
  customers    Customer[]
  suppliers    Supplier[]
  warehouses   Warehouse[]
  machines     Machine[]
  users        User[]
  plants       Plant[]
}

// Subscription plan offered to customer organizations. Limits: 0 = unlimited.
model Plan {
  id            String   @id @default(cuid())
  name          String   @unique
  priceMonthly  Float    @default(0)
  priceYearly   Float    @default(0)
  maxUsers      Int      @default(0)
  maxWarehouses Int      @default(0)
  maxItems      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companies     Company[]
}

model Plant {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  address   String? @db.Text
  city      String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String
  phone     String?
  role      String   @default("VIEWER") // SUPER_ADMIN|TENANT_ADMIN|MANAGEMENT|PLANT_MANAGER|PRODUCTION_MANAGER|PRODUCTION_SUPERVISOR|OPERATOR|PURCHASE_MANAGER|PURCHASE_EXECUTIVE|SALES_MANAGER|SALES_EXECUTIVE|STORE_MANAGER|STORE_OPERATOR|QUALITY_MANAGER|QC_INSPECTOR|ACCOUNTS_MANAGER|ACCOUNTANT|MAINTENANCE_MANAGER|DISPATCH_MANAGER|VIEWER
  passwordHash String? // scrypt "salt:hash" — null falls back to demo password 'demo1234' at login
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, email])
}

// ---------------- Masters ----------------

model Item {
  id            String   @id @default(cuid())
  companyId     String
  code          String
  name          String
  type          String   @default("RAW") // RAW|SEMI|FINISHED|CONSUMABLE|SERVICE
  category      String?
  uom           String   @default("NOS")
  hsn           String?
  gstRate       Float    @default(18)
  batchTracked  Boolean  @default(false)
  reorderLevel  Float    @default(0)
  minStock      Float    @default(0)
  maxStock      Float?
  purchasePrice Float    @default(0)
  sellingPrice  Float    @default(0)
  standardCost  Float    @default(0)
  description   String? @db.Text
  status        String   @default("ACTIVE") // ACTIVE|INACTIVE
  brand         String?
  partNo        String?  // manufacturer / drawing part number
  barcode       String?
  leadTimeDays  Int?     // purchase lead time, used for planning
  altUom        String?  // secondary unit, e.g. BOX
  altFactor     Float?   // 1 altUom = altFactor base units (1 BOX = 24 PCS)
  mrp           Float?
  priceIncludesTax Boolean @default(false) // selling price entered incl. GST
  rack          String?  // storage location / rack
  cessRate      Float    @default(0)
  trackSerial   Boolean  @default(false) // serial / IMEI per unit
  variantOf     String?  // parent item id for size/colour variants
  variantAttrs  String?  @db.Text // JSON { size: "M", color: "Red" }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id])
  balances      StockBalance[]
  ledger        StockLedger[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

model Customer {
  id               String   @id @default(cuid())
  companyId        String
  code             String
  name             String
  gstin            String?
  tallyLedgerName  String? // ledger name in Tally, when it differs from the customer name
  contactPerson    String?
  phone            String?
  email            String?
  addressLine      String? @db.Text
  city             String?
  state            String?
  stateCode        String? // for IGST/CGST-SGST decision
  paymentTermsDays Int      @default(30)
  creditLimit      Float    @default(0)
  status           String   @default("ACTIVE")
  // ---- Party profile (shared shape with Customer/Supplier) ----
  nickName         String?
  altPhone         String?
  pan              String?
  addressLine2     String? @db.Text
  pincode          String?
  country          String   @default("India")
  bankIfsc         String?
  bankName         String?
  bankAccountNo    String?
  bankBranch       String?
  openingBalance   Float    @default(0) // carried forward: customer = they owe us, supplier = we owe them
  notes            String?  @db.Text
  // "Both" party: the linked Supplier record for the same business (profile fields kept in sync)
  supplierId       String?  @unique
  gstType          String   @default("UNREGISTERED") // REGULAR|COMPOSITION|UNREGISTERED|CONSUMER|OVERSEAS|SEZ
  shippingAddress  String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id])
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  quotations       Quotation[]

  @@unique([companyId, code])
}

model Supplier {
  id               String   @id @default(cuid())
  companyId        String
  code             String
  name             String
  gstin            String?
  tallyLedgerName  String? // ledger name in Tally, when it differs from the customer name
  contactPerson    String?
  phone            String?
  email            String?
  addressLine      String? @db.Text
  city             String?
  state            String?
  stateCode        String?
  paymentTermsDays Int      @default(30)
  creditLimit      Float    @default(0)
  status           String   @default("ACTIVE")
  // ---- Party profile (shared shape with Customer/Supplier) ----
  nickName         String?
  altPhone         String?
  pan              String?
  addressLine2     String? @db.Text
  pincode          String?
  country          String   @default("India")
  bankIfsc         String?
  bankName         String?
  bankAccountNo    String?
  bankBranch       String?
  openingBalance   Float    @default(0) // carried forward: customer = they owe us, supplier = we owe them
  notes            String?  @db.Text
  gstType          String   @default("UNREGISTERED") // REGULAR|COMPOSITION|UNREGISTERED|CONSUMER|OVERSEAS|SEZ
  shippingAddress  String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id])
  customer         Customer?
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, code])
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  type      String   @default("GENERAL") // RM|FG|GENERAL|SCRAP
  location  String?
  address   String? @db.Text
  inCharge  String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model Machine {
  id             String   @id @default(cuid())
  companyId      String
  code           String
  name           String
  workCenter     String?
  capacityPerDay Float    @default(0)
  status         String   @default("RUNNING") // RUNNING|IDLE|MAINTENANCE|BREAKDOWN
  hourlyRate     Float    @default(0)
  notes          String? @db.Text
  make            String?
  model           String?
  serialNo        String?
  purchaseDate    DateTime?
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  serviceIntervalDays Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

// ---------------- BOM / Routing ----------------

model Bom {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  outputItemId String
  outputQty    Float    @default(1)
  version      String   @default("V1")
  scrapPct     Float    @default(0)
  status       String   @default("ACTIVE") // DRAFT|ACTIVE|RETIRED
  notes        String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        BomItem[]

  @@unique([companyId, code])
}

model BomItem {
  id       String @id @default(cuid())
  bomId    String
  itemId   String
  qty      Float
  scrapPct Float  @default(0)

  bom      Bom    @relation(fields: [bomId], references: [id], onDelete: Cascade)
}

// ---------------- Sales ----------------

model Enquiry {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  customerId  String
  date        DateTime
  contactName String?
  source      String?  // WALK_IN|PHONE|WEB|REFERRAL
  notes       String? @db.Text
  status      String   @default("OPEN") // OPEN|QUOTED|WON|LOST|CLOSED
  requiredBy    DateTime?
  expectedValue Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       EnquiryItem[]
  quotations  Quotation[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model EnquiryItem {
  id        String  @id @default(cuid())
  enquiryId String
  itemId    String
  qty       Float
  notes     String? @db.Text

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
}

model Quotation {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  enquiryId     String?
  customerId    String
  date          DateTime
  validUntil    DateTime?
  status        String    @default("DRAFT") // DRAFT|SENT|APPROVED|REJECTED|CONVERTED|CANCELLED
  subtotal      Float     @default(0)
  discountTotal Float     @default(0)
  cgst          Float     @default(0)
  sgst          Float     @default(0)
  igst          Float     @default(0)
  grandTotal    Float     @default(0)
  notes         String? @db.Text
  kindAttn      String?
  paymentTerms  String?
  deliveryTerms String?
  terms         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer  @relation(fields: [customerId], references: [id])
  enquiry       Enquiry?  @relation(fields: [enquiryId], references: [id])
  items         QuotationItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  itemId      String
  qty         Float
  rate        Float
  discountPct Float     @default(0)
  gstRate     Float     @default(18)
  lineTotal   Float     @default(0)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id             String    @id @default(cuid())
  companyId      String
  number         String
  quotationId    String?
  customerId     String
  orderDate      DateTime
  deliveryDate   DateTime?
  status         String    @default("DRAFT") // DRAFT|CONFIRMED|IN_PRODUCTION|READY|PARTIALLY_DISPATCHED|DISPATCHED|COMPLETED|CANCELLED
  subtotal       Float     @default(0)
  discountTotal  Float     @default(0)
  cgst           Float     @default(0)
  sgst           Float     @default(0)
  igst           Float     @default(0)
  grandTotal     Float     @default(0)
  notes          String? @db.Text
  customerPoNo    String?
  customerPoDate  DateTime?
  paymentTerms    String?
  deliveryTerms   String?
  shippingAddress String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer       Customer  @relation(fields: [customerId], references: [id])
  items          SalesOrderItem[]
  workOrders     WorkOrder[]
  deliveries     DeliveryChallan[]
  invoices       SalesInvoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, orderDate])
}

model SalesOrderItem {
  id            String      @id @default(cuid())
  salesOrderId  String
  itemId        String
  qty           Float
  rate          Float
  discountPct   Float       @default(0)
  gstRate       Float       @default(18)
  lineTotal     Float       @default(0)
  dispatchedQty Float       @default(0)
  invoicedQty   Float       @default(0)

  salesOrder    SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model DeliveryChallan {
  id            String      @id @default(cuid())
  companyId     String
  number        String
  salesOrderId  String
  warehouseId   String
  date          DateTime
  vehicleNo     String?
  transporter   String?
  ewayBillNo    String?
  status        String      @default("DRAFT") // DRAFT|DISPATCHED|CANCELLED
  notes         String? @db.Text
  lrNo            String?   // transporter LR / GR number
  lrDate          DateTime?
  shippingAddress String?   @db.Text
  driverPhone     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  salesOrder    SalesOrder  @relation(fields: [salesOrderId], references: [id])
  items         DeliveryChallanItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, date])
}

model DeliveryChallanItem {
  id              String          @id @default(cuid())
  challanId       String
  salesOrderItemId String?
  itemId          String
  qty             Float

  batchNo   String?
  serials   String?     @db.Text
  challan         DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
}

model SalesInvoice {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  salesOrderId  String?
  challanId     String?
  customerId    String
  date          DateTime
  dueDate       DateTime?
  placeOfSupply String?
  isInterState  Boolean   @default(false)
  subtotal      Float     @default(0)
  discountTotal Float     @default(0)
  cgst          Float     @default(0)
  sgst          Float     @default(0)
  igst          Float     @default(0)
  grandTotal    Float     @default(0)
  paidAmount    Float     @default(0)
  status        String    @default("UNPAID") // UNPAID|PARTIALLY_PAID|PAID|CANCELLED
  irn           String?
  ewayBillNo    String?
  notes         String? @db.Text
  customerPoNo    String?
  customerPoDate  DateTime?
  shippingAddress String?   @db.Text
  vehicleNo       String?
  transporter     String?
  // ---- Bill-level adjustments (Phase 1) ----
  billDiscount   Float     @default(0) // flat ₹ off the whole bill, applied before GST across lines
  freightCharge  Float     @default(0)
  freightGstRate Float     @default(18)
  packingCharge  Float     @default(0)
  packingGstRate Float     @default(18)
  roundOff       Float     @default(0) // + / − paise to make the total a whole rupee
  isCashSale     Boolean   @default(false)
  billingName     String?   // printed instead of the party name (e.g. "M/s Sharma Traders")
  driverPhone     String?
  deductStock     Boolean   @default(false) // direct / cash sale (no challan): stock went out with this invoice
  stockWarehouseId String?
  cess            Float     @default(0)
  accountId       String?   // where "Received now" money went (Cash & Bank)
  shareToken      String?   @unique // public share link (WhatsApp / PDF)
  // ---- GST document options (ported from the free GST billing app) ----
  docType         String    @default("TAX_INVOICE") // TAX_INVOICE | BILL_OF_SUPPLY | PROFORMA
  // ---- Tally export (voucher JSON/XML) ----
  tallyXmlDownloadedAt DateTime? // last time the import file was downloaded
  tallySentAt          DateTime? // marked as imported into Tally (locks nothing, just records it)
  reverseCharge   Boolean   @default(false) // GST payable by the recipient (Sec 9(3)/9(4))
  currency        String    @default("INR") // document currency (ISO-4217)
  fxRate          Float     @default(1) // 1 unit of `currency` in INR
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer  @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  items         SalesInvoiceItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, date])
}

model SalesInvoiceItem {
  id        String       @id @default(cuid())
  invoiceId String
  itemId    String
  hsn       String?
  qty       Float
  rate      Float
  discountPct Float      @default(0)
  gstRate   Float        @default(18)
  lineTotal Float        @default(0)

  cessRate  Float        @default(0)
  batchNo   String?
  serials   String?      @db.Text // newline-separated serial / IMEI numbers
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ---------------- Purchase ----------------

model PurchaseRequisition {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  date        DateTime
  requiredBy  DateTime?
  department  String?
  raisedBy    String?
  status      String   @default("PENDING") // PENDING|APPROVED|REJECTED|CONVERTED|CLOSED
  notes       String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseRequisitionItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model PurchaseRequisitionItem {
  id        String              @id @default(cuid())
  prId      String
  itemId    String
  qty       Float
  notes     String? @db.Text

  pr        PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id             String    @id @default(cuid())
  companyId      String
  number         String
  prId           String?
  supplierId     String
  orderDate      DateTime
  expectedDate   DateTime?
  status         String    @default("PENDING_APPROVAL") // DRAFT|PENDING_APPROVAL|APPROVED|PARTIALLY_RECEIVED|RECEIVED|INVOICED|CANCELLED
  subtotal       Float     @default(0)
  discountTotal  Float     @default(0)
  cgst           Float     @default(0)
  sgst           Float     @default(0)
  igst           Float     @default(0)
  grandTotal     Float     @default(0)
  approvedBy     String?
  approvedAt     DateTime?
  notes          String? @db.Text
  paymentTerms   String?
  deliveryTerms  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  grns           Grn[]
  invoices       PurchaseInvoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@index([companyId, orderDate])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  itemId      String
  qty         Float
  rate        Float
  gstRate     Float         @default(18)
  lineTotal   Float         @default(0)
  receivedQty Float         @default(0)

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
}

model Grn {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  poId        String
  warehouseId String
  date        DateTime
  supplierInvNo String?
  status      String   @default("PENDING_QC") // PENDING_QC|PARTIALLY_ACCEPTED|POSTED|CANCELLED
  notes       String? @db.Text
  supplierInvDate   DateTime?
  supplierChallanNo String?
  vehicleNo         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  po          PurchaseOrder @relation(fields: [poId], references: [id])
  items       GrnItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, date])
}

model GrnItem {
  id          String @id @default(cuid())
  grnId       String
  poItemId    String?
  itemId      String
  orderedQty  Float
  receivedQty Float
  acceptedQty Float  @default(0)
  rejectedQty Float  @default(0)
  qcStatus    String @default("PENDING") // PENDING|PASSED|FAILED|PARTIAL

  batchNo   String?
  mfgDate   DateTime?
  expiryDate DateTime?
  serials   String?     @db.Text
  grn         Grn    @relation(fields: [grnId], references: [id], onDelete: Cascade)
}

model PurchaseInvoice {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  poId          String?
  grnId         String?
  supplierId    String
  date          DateTime
  supplierInvNo String?
  isInterState  Boolean   @default(false)
  subtotal      Float     @default(0)
  discountTotal Float     @default(0)
  cgst          Float     @default(0)
  sgst          Float     @default(0)
  igst          Float     @default(0)
  grandTotal    Float     @default(0)
  paidAmount    Float     @default(0)
  status        String    @default("UNPAID") // UNPAID|PARTIALLY_PAID|PAID|CANCELLED
  notes         String? @db.Text
  supplierInvDate DateTime?
  dueDate         DateTime?
  // ---- Bill-level adjustments (Phase 1) ----
  billDiscount   Float     @default(0) // flat ₹ off the whole bill, applied before GST across lines
  freightCharge  Float     @default(0)
  freightGstRate Float     @default(18)
  packingCharge  Float     @default(0)
  packingGstRate Float     @default(18)
  roundOff       Float     @default(0) // + / − paise to make the total a whole rupee
  cess            Float     @default(0)
  accountId       String?   // where "Paid now" money came from
  reverseCharge   Boolean   @default(false) // RCM purchase: the company pays the GST (Sec 9(3)/9(4))
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  po            PurchaseOrder? @relation(fields: [poId], references: [id])
  items         PurchaseInvoiceItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@index([companyId, date])
}

model PurchaseInvoiceItem {
  id        String          @id @default(cuid())
  invoiceId String
  itemId    String
  hsn       String?
  qty       Float
  rate      Float
  gstRate   Float           @default(18)
  lineTotal Float           @default(0)

  cessRate  Float           @default(0)
  batchNo   String?
  mfgDate   DateTime?
  expiryDate DateTime?
  serials   String?         @db.Text
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ---------------- Payments / Finance ----------------

model Payment {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  type        String // RECEIPT (from customer) | PAYMENT (to supplier)
  partyType   String   @default("CUSTOMER") // CUSTOMER|SUPPLIER
  customerId  String?
  supplierId  String?
  invoiceType String?  // SALES|PURCHASE
  invoiceId   String?
  amount      Float
  mode        String   @default("NEFT") // CASH|BANK|UPI|CHEQUE|NEFT|RTGS|CREDIT_NOTE|DEBIT_NOTE
  date        DateTime
  reference   String?
  notes       String? @db.Text
  accountId   String?   // Cash & Bank account
  // Application rows (no money moves): the source of the credit applied to `invoiceId` — the customer advance
  // payment (mode ADVANCE_ADJ) or the sales return whose credit is applied to another invoice (mode CREDIT_NOTE)
  allocatedFromId String?
  chequeNo    String?
  chequeDate  DateTime?
  chequeStatus String?  // PENDING|DEPOSITED|CLEARED|BOUNCED (post-dated cheques)
  clearedDate DateTime? // bank reconciliation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, type])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
  @@index([invoiceId])
  @@index([companyId, date])
  @@index([allocatedFromId])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  date        DateTime
  category    String   @default("GENERAL") // UTILITIES|FREIGHT|RENT|SALARY|MAINTENANCE|TOOLING|OTHER
  description String @db.Text
  amount      Float
  paymentMode String   @default("CASH")
  paidTo      String?
  gstAmount   Float    @default(0)
  status      String   @default("POSTED") // DRAFT|POSTED|CANCELLED
  vendorGstin String?
  billNo      String?
  billDate    DateTime?
  itcEligible Boolean  @default(false) // GST input credit can be claimed
  accountId   String?
  expenseType String   @default("INDIRECT") // DIRECT (production/freight) | INDIRECT (rent, salary…)
  clearedDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, category])
  @@index([companyId, date])
}

// ---------------- Manufacturing ----------------

model WorkOrder {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  itemId        String
  bomId         String?
  salesOrderId  String?
  warehouseId   String
  plannedQty    Float
  producedQty   Float     @default(0)
  rejectedQty   Float     @default(0)
  scrapQty      Float     @default(0)
  status        String    @default("PLANNED") // PLANNED|RELEASED|IN_PROGRESS|COMPLETED|CANCELLED
  startDate     DateTime
  dueDate       DateTime?
  priority      String    @default("NORMAL") // NORMAL|HIGH|URGENT
  notes         String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  issues        MaterialIssue[]
  entries       ProductionEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, itemId])
  @@index([bomId])
}

model MaterialIssue {
  id          String    @id @default(cuid())
  companyId   String
  number      String
  workOrderId String
  date        DateTime
  status      String    @default("POSTED") // DRAFT|POSTED|CANCELLED
  notes       String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  items       MaterialIssueItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model MaterialIssueItem {
  id          String        @id @default(cuid())
  issueId     String
  itemId      String
  requiredQty Float
  issuedQty   Float

  issue       MaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model ProductionEntry {
  id          String    @id @default(cuid())
  companyId   String
  workOrderId String
  date        DateTime
  producedQty Float
  rejectedQty Float     @default(0)
  scrapQty    Float     @default(0)
  operator    String?
  downtimeMins Int      @default(0)
  notes       String? @db.Text
  createdAt   DateTime  @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  @@index([companyId, date])
}

// ---------------- Quality ----------------

model QcInspection {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  type        String // INCOMING|IN_PROCESS|FINAL
  refType     String // GRN|WORK_ORDER
  refId       String
  refNumber   String?
  itemId      String
  qtyChecked  Float
  qtyAccepted Float    @default(0)
  qtyRejected Float    @default(0)
  parameters  String? @db.Text // JSON: [{name, expected, actual, ok}]
  status      String   @default("PENDING") // PENDING|PASSED|FAILED|PARTIAL
  inspector   String?
  date        DateTime
  remarks     String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([refType, refId])
}

// ---------------- Inventory ----------------

model StockLedger {
  id           String   @id @default(cuid())
  companyId    String
  date         DateTime
  itemId       String
  warehouseId  String
  type         String // OPENING|GRN_IN|ISSUE_OUT|PRODUCTION_IN|DISPATCH_OUT|TRANSFER_IN|TRANSFER_OUT|ADJUST_IN|ADJUST_OUT|RETURN_IN|QC_REJECT|SALES_RETURN
  qtyIn        Float    @default(0)
  qtyOut       Float    @default(0)
  rate         Float    @default(0)
  // Outward rows: the weighted-average inventory cost per unit at the moment the stock left (sales returns
  // re-enter goods at this cost). `rate` on sale rows is the selling price. Null = row written before this field.
  costRate     Float?
  refType      String?  // GRN|MATERIAL_ISSUE|WORK_ORDER|DELIVERY|TRANSFER|ADJUSTMENT|OPENING
  refId        String?
  refNumber    String?
  notes        String? @db.Text
  reasonType   String?  // adjustments: DAMAGE|EXPIRY|THEFT|SAMPLE|CORRECTION|OTHER
  createdAt    DateTime @default(now())

  item         Item     @relation(fields: [itemId], references: [id])

  @@index([companyId, itemId])
  @@index([companyId, date])
  @@index([refType, refId])
  @@index([companyId, warehouseId])
}

model StockBalance {
  id          String @id @default(cuid())
  companyId   String
  itemId      String
  warehouseId String
  qty         Float  @default(0)
  avgRate     Float  @default(0)

  item        Item   @relation(fields: [itemId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([companyId, itemId])
}

// ---------------- System / Ops ----------------

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userName  String?
  action    String // CREATE|UPDATE|DELETE|APPROVE|REJECT|POST|COMPLETE|CANCEL|LOGIN|CONFIG
  entity    String
  entityId  String?
  details   String? @db.Text
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  title     String
  message   String? @db.Text
  level     String   @default("INFO") // INFO|WARNING|CRITICAL
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, read])
}

model NumberSeq {
  id            String @id @default(cuid())
  companyId     String
  docType       String // SO|PO|INV|PINV|GRN|WO|QC|PR|ENQ|QT|DN|MI|RCPT|PYMT|EXP|TRF|ADJ
  prefix        String
  financialYear String
  nextNumber    Int    @default(1)

  @@unique([companyId, docType, financialYear])
}

// Cash & Bank Phase 5: one row per Idempotency-Key a client sent with a money-creating request. The row is
// claimed (PENDING) before the business transaction and marked DONE inside it, together with the response that a
// retry with the same key gets back. Failed requests remove their row; rows are purged after 7 days.
model IdempotencyKey {
  id          String   @id @default(cuid())
  companyId   String
  key         String   @db.VarChar(100)
  userId      String
  route       String   @db.VarChar(120)
  requestHash String   @db.VarChar(64)
  status      String   @default("PENDING") // PENDING | DONE
  statusCode  Int?
  response    String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key])
  @@index([createdAt])
}

// ---------------- Returns (Phase 1) ----------------

// Sales Return / Credit Note: goods back from a customer against a sales invoice.
// Stock comes back in; the credit is adjusted against the invoice (as a CREDIT_NOTE payment).
model SalesReturn {
  id            String   @id @default(cuid())
  companyId     String
  number        String
  invoiceId     String
  customerId    String
  warehouseId   String
  date          DateTime
  reason        String?
  isInterState  Boolean  @default(false)
  subtotal      Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  grandTotal    Float    @default(0)
  status        String   @default("POSTED") // POSTED|CANCELLED
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         SalesReturnItem[]

  @@unique([companyId, number])
  @@index([companyId, invoiceId])
  @@index([companyId, customerId])
  @@index([companyId, date])
}

model SalesReturnItem {
  id             String      @id @default(cuid())
  returnId       String
  invoiceItemId  String?
  itemId         String
  qty            Float
  rate           Float
  gstRate        Float       @default(18)
  lineTotal      Float       @default(0)
  ret            SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

// Purchase Return / Debit Note: goods sent back to a supplier against a purchase bill.
// Stock goes out; the debit is adjusted against the bill (as a DEBIT_NOTE payment).
model PurchaseReturn {
  id            String   @id @default(cuid())
  companyId     String
  number        String
  invoiceId     String
  supplierId    String
  warehouseId   String
  date          DateTime
  reason        String?
  isInterState  Boolean  @default(false)
  subtotal      Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  grandTotal    Float    @default(0)
  status        String   @default("POSTED") // POSTED|CANCELLED
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         PurchaseReturnItem[]

  @@unique([companyId, number])
  @@index([companyId, invoiceId])
  @@index([companyId, supplierId])
  @@index([companyId, date])
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  invoiceItemId  String?
  itemId         String
  qty            Float
  rate           Float
  gstRate        Float          @default(18)
  lineTotal      Float          @default(0)
  ret            PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

// ---------------- Cash & Bank (Phase 2) ----------------

// A money account: the company's cash box or a bank account. Balance = opening + all money movements.
model MoneyAccount {
  id             String    @id @default(cuid())
  companyId      String
  type           String    // CASH | BANK
  name           String    // display name, e.g. "Cash in Hand", "SBI Current A/c"
  bankName       String?
  accountNo      String?
  ifsc           String?
  branch         String?
  upiId          String?
  holderName     String?
  openingBalance Float     @default(0)
  openingDate    DateTime?
  printOnInvoice Boolean   @default(false)
  isDefault      Boolean   @default(false) // default for its type
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId, type])
}

// Money movement that is not a party payment or an expense:
// cash/bank adjustments (capital, drawings, other income), contra transfers, loan receipts and EMIs.
model AccountTxn {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  date          DateTime
  type          String    // ADJUST_IN | ADJUST_OUT | CONTRA | LOAN_IN | LOAN_EMI
  fromAccountId String?   // money leaves this account
  toAccountId   String?   // money enters this account
  amount        Float
  category      String?   // CAPITAL | DRAWINGS | OTHER_INCOME | OTHER_EXPENSE | OTHER
  loanId        String?
  principal     Float?    // LOAN_EMI split
  interest      Float?
  reference     String?
  notes         String?   @db.Text
  clearedDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([companyId, loanId])
}

model Loan {
  id                String    @id @default(cuid())
  companyId         String
  name              String    // e.g. "HDFC Machinery Loan"
  lender            String?
  loanAccountNo     String?
  principal         Float
  interestRate      Float     @default(0) // % per year
  processingFee     Float     @default(0)
  startDate         DateTime
  termMonths        Int?
  emiAmount         Float?
  receivedAccountId String?   // where the loan money was credited
  status            String    @default("OPEN") // OPEN | CLOSED
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, status])
}

// ---------------- Batch / Serial (Phase 4) ----------------

model ItemBatch {
  id          String    @id @default(cuid())
  companyId   String
  itemId      String
  warehouseId String
  batchNo     String
  mfgDate     DateTime?
  expiryDate  DateTime?
  qty         Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, warehouseId, batchNo])
  @@index([companyId, expiryDate])
}

model ItemSerial {
  id          String    @id @default(cuid())
  companyId   String
  itemId      String
  serialNo    String
  status      String    @default("IN_STOCK") // IN_STOCK | SOLD | RETURNED_TO_SUPPLIER
  warehouseId String?
  inRefType   String?
  inRefId     String?
  outRefType  String?
  outRefId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, itemId, serialNo])
  @@index([companyId, status])
}

// ---------------- Multi-firm (Phase 5) ----------------

// Extra companies a login may open (its home company is User.companyId). Same role in every firm.
model UserCompanyAccess {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}
